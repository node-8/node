{
  "schemaVersion": 1,
  "specVersion": "node-8-string-semantics-0",
  "decisionIds": ["D13"],
  "operation": "Buffer.from(inputHex, 'hex').toString('utf8')",
  "observation": "String length and charCodeAt(i) for every observable code unit",
  "cases": [
    {
      "id": "ascii",
      "inputHex": "616263",
      "expected": {
        "stock": { "length": 3, "units": [97, 98, 99] },
        "node-8": { "length": 3, "units": [97, 98, 99] }
      }
    },
    {
      "id": "cjk",
      "inputHex": "e4b8ad",
      "expected": {
        "stock": { "length": 1, "units": [20013] },
        "node-8": { "length": 3, "units": [228, 184, 173] }
      }
    },
    {
      "id": "emoji",
      "inputHex": "f09f9880",
      "expected": {
        "stock": { "length": 2, "units": [55357, 56832] },
        "node-8": { "length": 4, "units": [240, 159, 152, 128] }
      }
    },
    {
      "id": "lone-continuation",
      "inputHex": "80",
      "expected": {
        "stock": { "length": 1, "units": [65533] },
        "node-8": { "length": 1, "units": [128] }
      }
    },
    {
      "id": "truncated-three-byte-sequence",
      "inputHex": "e282",
      "expected": {
        "stock": { "length": 1, "units": [65533] },
        "node-8": { "length": 2, "units": [226, 130] }
      }
    },
    {
      "id": "invalid-continuation",
      "inputHex": "e228a1",
      "expected": {
        "stock": { "length": 3, "units": [65533, 40, 65533] },
        "node-8": { "length": 3, "units": [226, 40, 161] }
      }
    },
    {
      "id": "overlong-sequence",
      "inputHex": "c0af",
      "expected": {
        "stock": { "length": 2, "units": [65533, 65533] },
        "node-8": { "length": 2, "units": [192, 175] }
      }
    },
    {
      "id": "wtf8-surrogate",
      "inputHex": "eda080",
      "expected": {
        "stock": { "length": 3, "units": [65533, 65533, 65533] },
        "node-8": { "length": 3, "units": [237, 160, 128] }
      }
    },
    {
      "id": "out-of-range-code-point",
      "inputHex": "f4908080",
      "expected": {
        "stock": { "length": 4, "units": [65533, 65533, 65533, 65533] },
        "node-8": { "length": 4, "units": [244, 144, 128, 128] }
      }
    },
    {
      "id": "embedded-nul",
      "inputHex": "610062",
      "expected": {
        "stock": { "length": 3, "units": [97, 0, 98] },
        "node-8": { "length": 3, "units": [97, 0, 98] }
      }
    }
  ]
}
